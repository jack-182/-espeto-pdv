# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENABLE_TEST_AUTH: Set to "true" ONLY in automated test / dev environments.
# In production, must be false or unset so test-tokens are strictly rejected.
ENABLE_TEST_AUTH="false"

# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS in production.
ALLOWED_ORIGINS=""
